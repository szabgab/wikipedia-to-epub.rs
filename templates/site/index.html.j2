<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wikipedia to EPUB</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
        background: #f6f8fa;
        color: #24292f;
      }
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
      }
      h1,
      h2 {
        margin-top: 0;
      }
      .button {
        display: inline-block;
        background: #0969da;
        color: white;
        text-decoration: none;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        font-weight: 600;
      }
      .downloads {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .example {
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
      }
      pre {
        background: #f6f8fa;
        border-radius: 6px;
        border: 1px solid #d0d7de;
        overflow-x: auto;
        padding: 0.75rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Wikipedia to EPUB</h1>
      <p>Download the most recently generated EPUB artifacts from CI.</p>
      <p>
        <a class="button" href="{{ artifact_url }}">Download latest generated books</a>
      </p>

      <h2>Compiled binaries</h2>
      <div class="downloads">
        {% for download in binary_downloads %}
        <a class="button" href="{{ download.href }}">Download for {{ download.label }}</a>
        {% endfor %}
      </div>

      <h2>Book configuration examples</h2>
      {% for example in examples %}
      <section class="example">
        <h3>{{ example.name }}</h3>
        <pre><code>{{ example.content }}</code></pre>
      </section>
      {% endfor %}
    </main>
  </body>
</html>
